{
  "name": "solis-appv2",
  "version": "1.0.0",
  "description": "Solis desktop application built with Electron, React, Vite, Tailwind CSS, and GitHub Releases auto-updates.",
  "private": true,
  "main": "main.js",
  "type": "commonjs",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "start": "electron .",
    "build:renderer": "vite build",
    "build": "npm run build:renderer && electron-builder --publish never",
    "release": "npm run build:renderer && electron-builder --publish always",
    "preview": "vite preview"
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "framer-motion": "13.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "tailwindcss": "4.3.3",
    "vite": "8.3.1"
  },
  "build": {
    "appId": "com.solissyst.solisappv2",
    "productName": "Solis",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "dist/renderer/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "publish": {
      "provider": "github",
      "owner": "solis-syst",
      "repo": "solis-appv2",
      "releaseType": "release",
      "publishAutoUpdate": true
    }
  }
}
